# Variables de entorno del frontend (solo nombres; sin secretos)
# URL base del API /v1 (API Gateway). Ej. https://xxxx.execute-api.us-east-2.amazonaws.com
VITE_API_BASE_URL=
# Tenant de la demo (hasta integrar Cognito)
VITE_TENANT_ID=t-demo

# Datos públicos de Cognito (no secretos)
VITE_COGNITO_REGION=us-east-2
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
